# Rename to .env.development if we run it in localhost
# Rename to .env.production if we run it in production
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_POSTGRES_DATABASE=[UR_DB]
SUPABASE_POSTGRES_HOST=[UR_HOST]
SUPABASE_POSTGRES_PASSWORD=[UR_PW]
SUPABASE_POSTGRES_PRISMA_URL=
SUPABASE_POSTGRES_URL=postgresql://[UR_USER]:[UR_PW]@[UR_HOST]:5432/[UR_DB]
SUPABASE_POSTGRES_URL_NON_POOLING=postgresql://[UR_USER]:[UR_PW]@[UR_HOST]:5432/[UR_DB]
SUPABASE_POSTGRES_USER=[UR_USER]
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web push ---
# Generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key ships to the browser; the private key signs, so it never leaves the server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services can use to reach us. Defaults to the site URL.
VAPID_SUBJECT=mailto:you@example.com
# Bearer token for /api/push/drain. Vercel Cron sends this automatically when set here.
CRON_SECRET=
# Guards the /admin/push actions (queue digest, cancel, send now).
PUSH_ADMIN_TOKEN=
